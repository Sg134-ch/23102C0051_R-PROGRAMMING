m <- matrix(1:12,nrow=3,ncol=4)
cat("\nMatrix:\n")
print(m)
cat("\nSecond Row:\n")
print(m[2,])
cat("\nThird Column:\n")
print(m[,3])
cat("\nSub Matrix:\n")
print(m[1:2,2:4])
cat("\nMatrix + 10\n")
print(m+10)
cat("\nMatrix * 5\n")
print(m*5)
student <- data.frame(
RollNo=c(101,102,103,104),
Name=c("Rahul","Priya","Aman","Neha"),
Age=c(20,21,20,22),
Marks=c(85,91,78,95)
)
cat("\nStudent Data Frame\n")
print(student)
cat("\nFirst Two Rows\n")
print(student[1:2,])
cat("\nName Column\n")
print(student$Name)
cat("\nMarks Column\n")
print(student[,4])
cat("\nStudents Scoring Above 80\n")
print(student[student$Marks>80,])
student$Result <- ifelse(student$Marks>=40,"Pass","Fail")
cat("\nUpdated Data Frame\n")
print(student)
student$Marks <- student$Marks + 5
cat("\nAfter Grace Marks\n")
print(student)
cat("\nAverage Marks\n")
print(mean(student$Marks))
cat("\nMaximum Marks\n")
print(max(student$Marks))
cat("\nMinimum Marks\n")
print(min(student$Marks))
