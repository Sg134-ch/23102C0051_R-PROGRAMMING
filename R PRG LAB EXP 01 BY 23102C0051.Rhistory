v <- c(10,20,30,40,50)
cat("Vector:\n")
print(v)
cat("\nFirst Element:\n")
print(v[1])
cat("\nThird Element:\n")
print(v[3])
cat("\nElements from 2 to 4:\n")
print(v[2:4])
cat("\nExclude First Element:\n")
print(v[-1])
cat("\nElements Greater Than 25:\n")
print(v[v>25])
cat("\nVector + 5\n")
print(v+5)
cat("\nVector * 2\n")
print(v*2)
cat("\nSquare of Vector\n")
print(v^2)
cat("\nSquare Root\n")
print(sqrt(v))
cat("\nMean = ")
print(mean(v))
cat("\nSum = ")
print(sum(v))
